# Local development: Docker Postgres (see docker-compose.yml)
DATABASE_URL=        # postgresql://echo:echo@localhost:5432/echo
DIRECT_URL=          # same as DATABASE_URL locally

# Tests use a separate local database; defaults to postgresql://echo:echo@localhost:5432/echo_test
# TEST_DATABASE_URL=

# Production (set in Vercel and GitHub Actions; never point local DATABASE_URL here)
# DATABASE_URL = Supabase transaction pooler (6543) + ?pgbouncer=true&connection_limit=1&sslmode=require
#   (TLS is verified against the pinned Supabase root CA in src/server/supabase-ca.ts)
# DIRECT_URL   = Supabase session pooler (5432) + ?sslmode=require   (migrations only)

AUTH_SECRET=         # openssl rand -base64 32 (a different value in production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=            # only if needed outside Vercel

# --- Phase 6: all optional locally and in CI; each feature is off when its variables are unset ---

# Rate limiting (spec §41). Production must set both; without them limits are off and a warning is logged.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (Sentry). DSNs are public; the auth token is only for uploading source maps at build.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Analytics (PostHog EU cloud, server-side only). The personal API key (scope person:write) and
# project ID let account deletion erase the user's events.
POSTHOG_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# POSTHOG_API_HOST=https://eu.posthog.com

# Shown on /privacy and /terms as the contact address.
NEXT_PUBLIC_CONTACT_EMAIL=
